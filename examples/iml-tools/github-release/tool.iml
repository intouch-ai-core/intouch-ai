{
  "name": "github-release",
  "version": "1.0.0",
  "displayName": "GitHub Release",
  "description": "Cut GitHub releases and attach files to them — create, update, delete releases and upload or remove their download assets. Requires an API Key credential holding a personal access token; the token never appears in the workflow.",
  "provider": "Blue Isle",
  "group": "Developer & DevOps",
  "assistantDescription": "github-release operation owner repo [tag name body draft prerelease releaseId assetFile assetName assetId] — use when the user asks to publish a release, tag a version, attach an installer or binary to a release, or list what a release contains. upload-asset is how a file larger than 1 MB reaches users. REQUIRES an API Key credential holding a GitHub personal access token.",
  "credentialBased": true,
  "credential": {
    "type": "apikey",
    "properties": {}
  },
  "input": {
    "operation": { "type": "string", "required": true, "description": "One of: create-release, list-releases, get-release, update-release, delete-release, list-assets, upload-asset, delete-asset" },
    "owner": { "type": "string", "required": true, "description": "Repository owner — the user or organisation login, e.g. 'intouch-ai-core'." },
    "repo": { "type": "string", "required": true, "description": "Repository name, e.g. 'intouch-ai'." },
    "tag": { "type": "string", "default": "", "description": "Git tag for the release, e.g. 'v8.0.5'. Required for create-release; on other operations it identifies which release to act on." },
    "name": { "type": "string", "default": "", "description": "Release title. Defaults to the tag." },
    "body": { "type": "string", "default": "", "description": "Release notes, markdown." },
    "draft": { "type": "string", "default": "false", "description": "true to create the release unpublished, so it is invisible until you publish it." },
    "prerelease": { "type": "string", "default": "false", "description": "true to mark it a pre-release rather than the latest stable version." },
    "targetCommitish": { "type": "string", "default": "", "description": "Branch or commit the tag is created from, when the tag does not exist yet. Blank uses the default branch." },
    "releaseId": { "type": "string", "default": "", "description": "Numeric release id, as an alternative to tag. list-releases reports it." },
    "assetFile": { "type": "string", "default": "", "description": "Path ON THE SERVER of the file to attach, for upload-asset. Held in memory during upload." },
    "assetName": { "type": "string", "default": "", "description": "Name the asset is downloaded as. Defaults to the file's own name." },
    "assetId": { "type": "string", "default": "", "description": "Numeric asset id, for delete-asset. list-assets reports it." }
  },
  "steps": [
    {
      "name": "run",
      "type": "python",
      "script": "github_release.py",
      "timeout": 900,
      "onError": "fail"
    }
  ],
  "publish": {
    "result": "{{run.result}}",
    "status": "{{run.status}}",
    "releaseId": "{{run.releaseId}}",
    "assetId": "{{run.assetId}}",
    "url": "{{run.url}}",
    "bytes": "{{run.bytes}}"
  },
  "maxTime": 960
}
